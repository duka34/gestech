# Ruta del archivo SQLite (se crea solo si no existe)
DATABASE_URL=db/gestech.sqlite3

# Clave de sesión: string aleatorio de al menos 32 caracteres.
# Generar uno propio para cada entorno, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se define, el servidor usa una clave fija de desarrollo (con warning en consola).
SESSION_SECRET=
